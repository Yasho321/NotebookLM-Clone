# ── Core (required — the app refuses to start without these) ──────────────────
MONGODB_URI=mongodb://localhost:27017/chithhilm
JWTSECRET_KEY=change-me-to-a-long-random-string
OPENAI_API_KEY=sk-...

# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
QUADRANT_URL=http://localhost:6333
QUADRANT_API_KEY=

# ── Object storage (S3 / Cloudflare R2) ───────────────────────────────────────
S3_API=https://<account>.r2.cloudflarestorage.com
S3_Access_Key_ID=
S3_Secret_Access_Key=
S3_BUCKET=chithhilm

# ── Redis (BullMQ queues) ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Neo4j (long-term memory graph) ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
# Optional: email that is granted admin (observability dashboard) access.
ADMIN_EMAIL=
